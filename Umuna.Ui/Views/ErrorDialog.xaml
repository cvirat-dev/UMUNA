<Window x:Class="Umuna.Ui.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Umuna.Ui.Infrastructure.Converters"
        xmlns:local="clr-namespace:Umuna.Ui.Views"
        mc:Ignorable="d"
        Title="{Binding ErrorTitle}"
        Width="500"
        MinHeight="200"
        MaxHeight="600"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Error Icon and Message -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Image Source="Assets/Icons/error.png" 
                   Width="32" Height="32"
                   Margin="0,0,15,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding ErrorMessage}" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Center"
                       FontSize="13"/>
        </StackPanel>

        <!-- Expandable Details Section -->
        <Expander x:Name="DetailsExpander" 
                  Grid.Row="1" 
                  Header="Technical Details" 
                  IsExpanded="False"
                  Margin="0,0,0,15"
                  Visibility="{Binding ExceptionDetails, Converter={StaticResource NullToVisibilityConverter}}">
            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding ExceptionDetails, Mode=OneWay}" 
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="10"
                         Padding="5"/>
            </ScrollViewer>
        </Expander>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">

            <Button Content="Copy Details" Margin="0,0,8,0" 
                    Click="OnCopyDetailsClick"
                    Visibility="{Binding ExceptionDetails, Converter={StaticResource NullToVisibilityConverter}}"/>

            <Button Content="Retry" Margin="0,0,8,0" 
                    Click="OnRetryClick"
                    Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Content="Close" Margin="0,0,8,0" 
                    Click="OnCloseClick" 
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
