<UserControl x:Class="Umuna.Ui.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Umuna.Ui.Views"
        xmlns:vm="clr-namespace:Umuna.Ui.ViewModels"
        mc:Ignorable="d">
    
    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER AREA -->
        <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left group -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="UMUNA Control Center" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBox Text="{Binding Status}" 
                         Width="200" 
                         IsReadOnly="True"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         BorderThickness="1"
                         Padding="4,2"/>

                <Button Content="Connect" 
                        Command="{Binding ConnectCommand}"
                        Width="100"
                        Height="28"
                        BorderThickness="1"
                        Padding="4,0"
                        Cursor="Hand"/>

                <Button Content="Disconnect"
                        Command="{Binding DisconnectCommand}"
                        Width="100"
                        Height="28"
                        Margin="10,0,0,0"
                        BorderThickness="1"
                        Padding="4,0"
                        Cursor="Hand"/>
            </StackPanel>

            <!-- Right group: User display and Log off -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="|" Margin="10,0,10,0" VerticalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="Signed in as:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DataContext.CurrentUser, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontWeight="SemiBold"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
                <Button Content="Log off"
                        Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="100"
                        Height="28"
                        Margin="10,0,0,0"
                        BorderThickness="1"
                        Padding="4,0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
        
        <!-- LOG / CONSOLE AREA -->
        <Border Grid.Row="1"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Log}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>