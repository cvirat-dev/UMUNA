# This .gitignore file should be placed at the root of your Unity project directory
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# ────────── Unity Generated Folders ──────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/
*.log
sysinfo.txt

# ────────── Unity Assets ──────────
*.blend1
*.blend1.meta
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.booproj
*.svd
*.opendb

# ────────── Mono Crash Dumps ──────────
mono_crash.*

# ────────── Unity Builds ──────────
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.dll
*.dll.meta

# ────────── Test Scenes ──────────
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ────────── Addressables ──────────
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ────────── Visual Scripting ──────────
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ────────── Asset Store Tools (Optional) ──────────
# /[Aa]ssets/AssetStoreTools*

# ────────── JetBrains Rider ──────────
/[Aa]ssets/Plugins/Editor/JetBrains*
.idea/
*.DotSettings.user

# ────────── Visual Studio ──────────
.vs/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db

# ────────── VS Code ──────────
.vscode/
*.code-workspace

# ────────── Gradle ──────────
.gradle/

# ────────── Consulo / MonoDevelop ──────────
ExportedObj/
.consulo/
*.unityproj

# ────────── Build Systems ──────────
[Bb]uild/
[Bb]uilds/
[Bb]in/
[Bb]in*/         # Covers bin/Debug, bin/Release etc.
[Oo]bj/
[Oo]bj*/

# ────────── Crashlytics ──────────
crashlytics-build.properties

# ────────── Rider Unity Plugin ──────────
/[Aa]ssets/Plugins/Editor/JetBrains*

# ────────── NuGet ──────────
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json

# ────────── Git Meta ──────────
*.orig
*.rej

# ────────── Unity Collaborate (Optional) ──────────
/.Collab/

# ────────── Auto Generated Meta Files (Optional) ──────────
# If you're auto-generating meta files and want to exclude them (usually not recommended)
# *.meta

# ────────── Rider Temp Solutions (optional) ──────────
*.sln.iml
